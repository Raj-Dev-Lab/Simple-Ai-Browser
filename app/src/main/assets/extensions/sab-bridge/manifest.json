{
  "manifest_version": 2,
  "name": "SAB Page Bridge",
  "version": "1.1.0",
  "description": "Built-in GeckoView content bridge for Force Dark CSS, Reader Focus, Find-in-Page helpers, and future AI context snapshots.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sab-bridge@simpleaibrowser.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
