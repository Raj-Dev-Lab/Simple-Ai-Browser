<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sab" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sab_obsidian</item>
        <item name="android:statusBarColor">@color/sab_obsidian</item>
        <item name="android:navigationBarColor">@color/sab_surface</item>
    </style>

    <style name="Theme.Sab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sab_obsidian</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Sab</item>
    </style>
</resources>
